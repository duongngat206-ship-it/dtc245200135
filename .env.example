# Application
NODE_ENV=production
APP_PORT=3000
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=24h

# Database MySQL
MYSQL_HOST=mysql_db
MYSQL_PORT=3306
MYSQL_DATABASE=blog_cms_db
MYSQL_USER=blog_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Admin account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@enterprise-blog.local
ADMIN_PASSWORD=your_admin_password

# phpMyAdmin
PMA_PORT=8080

# Nginx ports
HTTP_PORT=80
HTTPS_PORT=443

# Monitoring & Logs
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password
LOKI_PORT=3100
CADVISOR_PORT=8081
