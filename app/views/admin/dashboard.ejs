<%- include('../partials/header') %>

<div class="admin-layout">
  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <div>
      <div style="padding: 0.5rem 1rem 1.5rem; font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-subtle);">
        Bảng điều khiển
      </div>
      <ul class="admin-menu">
        <li>
          <a href="/admin" class="admin-menu-link <%= activeMenu === 'dashboard' ? 'active' : '' %>">
            <span>📊</span> <span>Tổng quan</span>
          </a>
        </li>
        <li>
          <a href="/admin/posts" class="admin-menu-link <%= activeMenu === 'posts' ? 'active' : '' %>">
            <span>📝</span> <span>Quản lý Bài viết</span>
          </a>
        </li>
        <li>
          <a href="/admin/categories" class="admin-menu-link <%= activeMenu === 'categories' ? 'active' : '' %>">
            <span>🏷️</span> <span>Quản lý Danh mục</span>
          </a>
        </li>
        <li>
          <a href="/admin/users" class="admin-menu-link <%= activeMenu === 'users' ? 'active' : '' %>">
            <span>👥</span> <span>Người dùng & Mật khẩu</span>
          </a>
        </li>
        <li style="margin-top: 1rem; border-top: 1px solid var(--border-subtle); padding-top: 1rem;">
          <a href="/phpmyadmin/" target="_blank" class="admin-menu-link" style="color: #93c5fd;">
            <span>🗄️</span> <span>phpMyAdmin (Port 8080) ↗</span>
          </a>
        </li>
      </ul>
    </div>

    <div style="padding: 1rem; border-top: 1px solid var(--border-subtle); font-size: 0.8125rem; color: var(--text-subtle);">
      Đăng nhập: <strong style="color: #fff"><%= currentUser.username %></strong><br>
      Vai trò: <span class="badge" style="background-color: var(--primary); margin-top: 0.25rem;"><%= currentUser.role %></span>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="admin-main">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
      <div>
        <h1 style="font-size: 1.75rem; font-weight: 800;">Tổng quan Hệ thống</h1>
        <p style="color: var(--text-muted); font-size: 0.875rem;">Theo dõi số liệu thời gian thực và quản trị nội dung</p>
      </div>
      <div style="display: flex; gap: 0.75rem;">
        <a href="/admin/posts/new" class="btn btn-primary" id="btn-create-post-top">✍️ Viết bài mới</a>
        <a href="/admin/users" class="btn btn-secondary">➕ Thêm tác giả</a>
      </div>
    </div>

    <!-- KPI Grid -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <div>
          <div class="kpi-title">Tổng số Bài viết</div>
          <div class="kpi-value"><%= stats.totalPosts %></div>
        </div>
        <div class="kpi-icon-wrap" style="background: rgba(37, 99, 235, 0.15); color: #3b82f6;">📰</div>
      </div>

      <div class="kpi-card">
        <div>
          <div class="kpi-title">Tổng lượt xem (Views)</div>
          <div class="kpi-value"><%= stats.totalViews %></div>
        </div>
        <div class="kpi-icon-wrap" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">👁️</div>
      </div>

      <div class="kpi-card">
        <div>
          <div class="kpi-title">Danh mục chuyên ngành</div>
          <div class="kpi-value"><%= stats.totalCategories %></div>
        </div>
        <div class="kpi-icon-wrap" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6;">🏷️</div>
      </div>

      <div class="kpi-card">
        <div>
          <div class="kpi-title">Tài khoản Quản trị/Tác giả</div>
          <div class="kpi-value"><%= stats.totalUsers %></div>
        </div>
        <div class="kpi-icon-wrap" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">👥</div>
      </div>
    </div>

    <!-- Recent Posts Table -->
    <div class="table-card">
      <div class="table-header">
        <h2 style="font-size: 1.125rem; font-weight: 700;">Bài viết mới cập nhật gần đây</h2>
        <a href="/admin/posts" style="font-size: 0.8125rem; color: var(--primary); font-weight: 600;">Xem tất cả bài viết →</a>
      </div>
      <table class="data-table">
        <thead>
          <tr>
            <th>Tiêu đề bài viết</th>
            <th>Danh mục</th>
            <th>Lượt xem</th>
            <th>Trạng thái</th>
            <th>Ngày tạo</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% recentPosts.forEach(post => { %>
            <tr>
              <td>
                <strong style="color: #fff"><%= post.title %></strong>
              </td>
              <td>
                <span class="badge" style="background-color: var(--bg-surface-elevated); border: 1px solid var(--border-light); color: var(--text-muted)">
                  <%= post.category_name || 'Chưa phân loại' %>
                </span>
              </td>
              <td><%= post.views %></td>
              <td>
                <span class="badge" style="background-color: <%= post.status === 'published' ? 'rgba(16, 185, 129, 0.2)' : 'rgba(245, 158, 11, 0.2)' %>; color: <%= post.status === 'published' ? '#10b981' : '#f59e0b' %>;">
                  <%= post.status === 'published' ? 'Đã xuất bản' : 'Bản nháp' %>
                </span>
              </td>
              <td><%= new Date(post.created_at).toLocaleDateString('vi-VN') %></td>
              <td>
                <a href="/admin/posts/<%= post.id %>/edit" class="btn btn-secondary btn-sm">Sửa</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
